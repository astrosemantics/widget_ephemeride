# Protection : réglages, bibliothèques et polices
# ne sont pas accessibles depuis le web. Seuls ephemeride-widget.php, ephemeride-4x4.php et wiki.php sont ouverts.
<FilesMatch "^(config\.php|README\.md|.*\.json|.*\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_alias.c>
    RedirectMatch 403 /(lib|cache|fonts)/
</IfModule>
